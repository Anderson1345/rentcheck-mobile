{
  "expo": {
    "name": "RentCheck",
    "slug": "rentcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentcheck",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rentcheck.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A1A1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1A1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RentCheck usa tus fotos solo para adjuntar comprobantes de pago, fotos de inmuebles y documentos que tú elijas.",
          "cameraPermission": "RentCheck usa la cámara para tomar fotos de comprobantes de pago, inmuebles y documentos.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
